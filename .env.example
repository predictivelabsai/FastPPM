# ── Storage ────────────────────────────────────────────────────────────────
# Relational backend: SQLite for local dev, Postgres in production.
DATA_STORAGE=sqlite
DB_URL=sqlite:///fastppm.db
# Production example:
# DB_URL=postgresql+psycopg2://user:pass@host:5432/fastppm

# Where uploaded source documents are stored (under the persistent volume in prod).
UPLOAD_DIR=data/uploads

# ── AI: xAI Grok (OpenAI-compatible API) ──────────────────────────────────────
# Optional — document normalisation AND the chat analyst degrade gracefully to
# heuristics / deterministic lookups when no key is set.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
LLM_PROVIDER=xai
GROK_MODEL=grok-4-1-fast-reasoning

# ── Auth ──────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
APP_SECRET=change-me

# Google OAuth sign-in (optional — login falls back to email/password if unset).
# Reuses the shared GCP OAuth client; register the redirect URI in the GCP console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://fastppm.predictivelabs.ai/auth/callback
# Access allowlist (comma-separated). Defaults cover predictivelabs/FastPPM.
GOOGLE_ALLOWED_DOMAINS=predictivelabs.co.uk,predictivelabs.ai
GOOGLE_ALLOWED_EMAILS=

# Set to 1 to disable the login gate (public demo).
FASTPPM_PUBLIC=0
